# Maintainer: Blaadick <null>

pkgname="blaadpapers-bin"
url="https://github.com/Blaadick/BlaadPapers"
pkgdesc="Fast & clean wallpaper manager (prebuilt binaries)"
license=("GPL-3.0-or-later")
pkgver="0.4.3"
pkgrel=1
arch=("x86_64" "aarch64")
depends=(
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "qt6-imageformats"
    "curl"
    "yyjson"
    "libvips"
    "ffmpeg"
    "mpvpaper"
    "bstyle-qml-theme"
)
provides=("blaadpapers")
conflicts=("blaadpapers" "blaadpapers-git")
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/blaadpapers-linux-x86_64.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/blaadpapers-linux-aarch64.tar.gz")
sha512sums_x86_64=("SKIP")
sha512sums_aarch64=("SKIP")

package() {
    install -Dm755 "blaadpapers" "$pkgdir/usr/bin/blaadpapers"
    install -Dm755 "blaadpaperscli" "$pkgdir/usr/bin/blaadpaperscli"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "blaadpapers.desktop" "$pkgdir/usr/share/applications/blaadpapers.desktop"
    install -Dm644 "blaadpapers-install.desktop" "$pkgdir/usr/share/applications/blaadpapers-install.desktop"
    install -Dm644 "blaadpapers-url.desktop" "$pkgdir/usr/share/applications/blaadpapers-url.desktop"
    install -Dm644 "blaadpaperscli.fish" "$pkgdir/usr/share/fish/vendor_completions.d/blaadpaperscli.fish"
    install -Dm644 "blaadpaperscli.zsh" "$pkgdir/usr/share/zsh/site-functions/_blaadpaperscli"
    install -Dm644 "blaadpapers.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/blaadpapers.svg"

    for size in 8 16 18 22 24 32 36 42 44 48 64 72 84 96 128 256 512 1024; do
        install -d "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
        vips thumbnail "blaadpapers.svg" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/blaadpapers.png" $size
    done
}
