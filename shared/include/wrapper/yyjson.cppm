    inline constexpr auto patchErrorMemoryAllocation = YYJSON_PATCH_ERROR_MEMORY_ALLOCATION;
    inline constexpr auto patchErrorInvalidOperation = YYJSON_PATCH_ERROR_INVALID_OPERATION;
    inline constexpr auto patchErrorMissingKey = YYJSON_PATCH_ERROR_MISSING_KEY;
    inline constexpr auto patchErrorInvalidMember = YYJSON_PATCH_ERROR_INVALID_MEMBER;
    inline constexpr auto patchErrorEqual = YYJSON_PATCH_ERROR_EQUAL;
    inline constexpr auto patchErrorPointer = YYJSON_PATCH_ERROR_POINTER;
}
